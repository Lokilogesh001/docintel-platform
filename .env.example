# ============================================================
# Environment Configuration Template
# Intelligent Document Extraction, Validation & API Platform
# ============================================================

# Application Configuration
APP_NAME=DocIntel-Platform
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# LLM Providers (Optional - Robust Fallback NLP Parser handles extraction if unset)
# Gemini API Key (Recommended for live AI extraction)
GEMINI_API_KEY=

# OpenAI / Compatible API Configuration (Optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini

# OCR Configuration (Optional - Native PyMuPDF handles text extraction automatically)
# OCR.Space Free API Key (Optional fallback for scanned documents)
OCR_SPACE_API_KEY=helloworld

# Database Configuration
DATABASE_URL=sqlite:///./docintel.db

# Processing Constraints
MAX_FILE_SIZE_MB=15
MAX_PAGE_COUNT=3
FINANCIAL_TOLERANCE=0.05
